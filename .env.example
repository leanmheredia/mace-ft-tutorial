# Local settings for the tutorial scripts.
# Copy to .env (git-ignored) and adjust for your machine:
#   cp .env.example .env
# Every variable is optional; unset ones fall back to the defaults noted below.
# Use absolute paths. Shell scripts source this file; Python scripts read it
# through python-dotenv if installed (pip install python-dotenv).

# Repository checkout (default: detected from the script location)
#MACE_FT_ROOT=/scratch/projects/CFP01/CFP01-CF-069/mace-ft-tutorial

# Torch device for MACE
MACE_DEVICE=cuda

# Command that runs MACE training (default: the mace_run_train entry point)
#MACE_RUN_TRAIN="python3 /home/coder/project/mace/mace/cli/run_train.py"

# --- examples/Mo -------------------------------------------------------------
# Working directory; training results go to $MO_WORK_DIR/results (default: examples/Mo)
#MO_WORK_DIR=/home/coder/project/run_jerry_al
# Model evaluated by plot_GSFE.sh (default: the stage-two model of the fine-tune run)
#GSFE_MODEL_PATH=

# --- examples/graphene-water -------------------------------------------------
# Fine-tuned model and the model it is compared against (default: both the bundled
# mace-ft-tutorial-main-3.model)
#GRAPHENE_FT_MODEL=
#GRAPHENE_REF_MODEL=

# --- test.py -----------------------------------------------------------------
# (default: models/mace-mp-0b3-medium.model)
#TEST_MODEL=

# --- lmp-mace-f32 ------------------------------------------------------------
LAMMPS_MODULE=lammps/28Mar2023
# Compiled LAMMPS model (default: the bundled *_compiled_f32.model-lammps.pt)
#LAMMPS_MACE_MODEL=/public/home/zkh/lmp-mace-kk/mace-ft-tutorial-main-3_compiled_f32.model-lammps.pt
